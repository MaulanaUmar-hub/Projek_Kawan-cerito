{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "buildCommand": "npm run build"
    },
    "deploy": {
        "startCommand": "sh -c 'php artisan serve --host=0.0.0.0 --port=${PORT:-8000}'",
        "preDeployCommand": "php artisan storage:link --force && php artisan migrate --force && php artisan config:cache && php artisan route:cache && php artisan view:cache",
        "healthcheckPath": "/healthcheck.txt",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
